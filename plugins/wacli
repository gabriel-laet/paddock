#!/usr/bin/env python3
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import lib  # noqa: E402

CHAT_LIMIT = 15
MSG_LIMIT = 15


def _chat_kind(chat: dict | None, jid: str) -> str:
    kind = ""
    if isinstance(chat, dict):
        kind = str(lib.pick(chat, "kind", "type") or "").lower()
    if kind == "group" or "@g.us" in jid:
        return "group"
    return "person"


def _from_me(msg: dict) -> bool:
    return bool(lib.pick(msg, "FromMe", "from_me", "fromMe"))


def _unread_budget(chat: dict | None) -> int | None:
    """How many of the newest incoming messages in `chat` are still unread.

    WhatsApp tracks unread per chat, not per message: `unread_count` is the
    size of the unread tail. `None` means we don't know (no chat info), so
    callers should leave read state unset rather than guess.
    """
    if not isinstance(chat, dict):
        return None
    if not chat.get("unread"):
        return 0
    n = lib.pick(chat, "unread_count", "unreadCount")
    try:
        return int(n) if n is not None else 0
    except (TypeError, ValueError):
        return 0


class ReadTracker:
    """Consumes each chat's unread budget as messages are walked newest-first."""

    def __init__(self, chats: dict[str, dict]) -> None:
        self._chats = chats
        self._budget: dict[str, int | None] = {}

    def read_for(self, chat_jid: str, chat: dict | None, msg: dict) -> bool | None:
        if _from_me(msg):
            return True
        if chat_jid not in self._budget:
            self._budget[chat_jid] = _unread_budget(chat or self._chats.get(chat_jid))
        budget = self._budget[chat_jid]
        if budget is None:
            return None
        if budget > 0:
            self._budget[chat_jid] = budget - 1
            return False
        return True


def map_message(msg: dict, chat: dict | None, read: bool | None = None) -> dict | None:
    if not isinstance(msg, dict):
        return None
    chat_jid = str(
        lib.pick(msg, "ChatJID", "chat_jid", "chatJid", "jid")
        or (lib.pick(chat, "jid") if chat else "")
        or ""
    ).strip()
    mid = str(lib.pick(msg, "MsgID", "msg_id", "msgId", "id") or "").strip()
    if not chat_jid or not mid:
        return None
    chat_name = lib.pick(msg, "ChatName", "chat_name", "chatName") or (
        lib.pick(chat, "name") if chat else None
    )
    sender_jid = str(lib.pick(msg, "SenderJID", "sender_jid", "senderJid", "from") or "").strip()
    sender_name = lib.pick(msg, "SenderName", "sender_name", "senderName")
    title = str(chat_name or sender_name or chat_jid)
    body = str(lib.pick(msg, "DisplayText", "display_text", "displayText", "Text", "text") or "")
    kind = _chat_kind(chat, chat_jid)
    ts = lib.pick(msg, "Timestamp", "timestamp", "ts")
    item = {
        "foreign_id": f"{chat_jid}/{mid}",
        "title": title,
        "body": body,
        "thread": chat_jid,
    }
    if ts:
        item["start"] = str(ts)
    if sender_jid:
        item["from"] = lib.actor(sender_jid, str(sender_name) if sender_name else None, kind)
    if read is not None:
        item["read"] = read
    if kind == "group":
        item["to"] = [lib.actor(chat_jid, str(chat_name) if chat_name else None, "group")]
    quoted = lib.pick(
        msg,
        "quoted_msg_id",
        "QuotedMsgID",
        "quotedMsgId",
        "quoted_id",
        "QuotedID",
    )
    if quoted:
        q = str(quoted)
        item["in_reply_to"] = q if "/" in q else f"{chat_jid}/{q}"
    path = lib.pick(msg, "LocalPath", "local_path", "localPath")
    if path:
        mime = lib.pick(msg, "MimeType", "mime_type", "mimeType")
        media = lib.pick(msg, "MediaType", "media_type", "mediaType")
        filename = lib.pick(msg, "Filename", "filename", "file_name")
        item["parts"] = [lib.media_part(str(path), mime, media, filename)]
    return item


def map_messages(raw, chat: dict | None) -> list[dict]:
    rows = raw
    if isinstance(raw, dict):
        rows = lib.unwrap_list(raw, "messages")
    if not isinstance(rows, list):
        rows = []
    budget = _unread_budget(chat)
    items: list[dict] = []
    for msg in rows:
        if not isinstance(msg, dict):
            continue
        if _from_me(msg):
            read = True
        elif budget is None:
            read = None
        elif budget > 0:
            read = False
            budget -= 1
        else:
            read = True
        item = map_message(msg, chat, read=read)
        if item:
            items.append(item)
    return items


def pull() -> None:
    fx = lib.load_fixture()
    if fx is not None:
        chats = {
            str(c.get("jid") or c.get("JID") or ""): c
            for c in lib.unwrap_list(fx, "chats")
            if isinstance(c, dict)
        }
        msgs = lib.unwrap_list(fx, "messages")
        if msgs:
            tracker = ReadTracker(chats)
            items: list[dict] = []
            for msg in msgs:
                if not isinstance(msg, dict):
                    continue
                jid = str(lib.pick(msg, "ChatJID", "chat_jid", "jid") or "")
                chat = chats.get(jid)
                item = map_message(msg, chat, read=tracker.read_for(jid, chat, msg))
                if item:
                    items.append(item)
            lib.emit_items(items)
            return
        lib.emit_items(map_messages(fx, None))
        return
    chats_raw = lib.wacli_run(
        ["--json", "--read-only", "chats", "list", "--limit", "30", "--no-archived"]
    )
    chats = lib.unwrap_list(chats_raw, "chats")
    if not chats and isinstance(chats_raw, list):
        chats = chats_raw
    items: list[dict] = []
    for chat in chats[:CHAT_LIMIT]:
        if not isinstance(chat, dict):
            continue
        jid = lib.pick(chat, "jid", "JID")
        if not jid:
            continue
        msgs = lib.wacli_run(
            [
                "--json",
                "--read-only",
                "messages",
                "list",
                "--chat",
                str(jid),
                "--limit",
                str(MSG_LIMIT),
            ],
            allow_fail=True,
        )
        items.extend(map_messages(msgs, chat))
    lib.emit_items(items)


def send() -> None:
    draft = lib.read_draft()
    to = None
    tos = draft.get("to") or []
    if tos and isinstance(tos[0], dict):
        to = tos[0].get("id")
    to = to or draft.get("thread")
    if not to:
        lib.die("no chat jid")
    args = ["send", "text", "--to", str(to), "--message", str(draft.get("body") or ""), "--json"]
    reply = str(draft.get("reply_to_foreign") or "").strip()
    if reply:
        args.extend(["--reply-to", lib.last_id(reply)])
    raw = lib.wacli_run(args)
    fid = lib.pick_foreign_id(raw)
    if not fid:
        fid = "sent"
    elif "/" not in fid:
        fid = f"{to}/{fid}"
    lib.emit_send(fid)


def main() -> None:
    v = lib.verb()
    if v == "pull":
        pull()
    elif v == "send":
        send()
    else:
        lib.die("usage: wacli pull|send")


if __name__ == "__main__":
    main()
